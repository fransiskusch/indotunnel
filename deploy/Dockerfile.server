# Build stage
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/indotunnel-server ./cmd/server

# Runtime stage
FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /out/indotunnel-server /app/indotunnel-server
COPY migrations /app/migrations
EXPOSE 8080 8081 7000
ENTRYPOINT ["/app/indotunnel-server"]
